# Copy this file to `.env` and fill in real values.
#
# RECOMMENDED — Brevo REST API (HTTPS — works from any network, including
# datacenter IPs like Render where the SMTP relay is blocked):
#   1. Create a free account at https://www.brevo.com
#   2. Settings → SMTP & API → API Keys → create a key (starts with xkeysib-)
#   3. Settings → Senders & IPs → Senders → add & verify your sender email
#   BREVO_API_KEY=xkeysib-...
#   BREVO_FROM=your-verified-sender@example.com
#
# Alternative — Brevo SMTP relay (may be unreachable from some cloud servers):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-smtp-login@smtp-brevo.com
#   SMTP_PASS=your-smtp-key
#
# Legacy option — Gmail SMTP (blocked from cloud servers):
#   Google Account → Security → 2-Step Verification → App Passwords
#   EMAIL_USER=yourgmail@gmail.com
#   EMAIL_PASS=your-16-character-app-password

BREVO_API_KEY=xkeysib-...
BREVO_FROM=your-verified-sender@example.com
ADMIN_EMAIL=admin@vertexsolutions.in

# Optional — port the server listens on (defaults to 5000)
# PORT=5000

# Google Sheets integration — appends each consultation form submission as a
# new row in the "Leads" tab. Failure never blocks the email.
#   1. https://console.cloud.google.com → create a Service Account → download JSON key
#   2. Share your sheet with the service account email as Editor
# GOOGLE_SHEET_ID=your-sheet-id-from-the-sheet-url
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY=<paste the full JSON key here, or its base64 encoding>
# GOOGLE_SHEET_NAME=Leads
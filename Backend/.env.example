# Copy this file to `.env` and fill in real values.
#
# RECOMMENDED — Brevo SMTP (free tier, works from datacenter IPs like Render/Vercel):
#   1. Create a free account at https://www.brevo.com
#   2. Go to SMTP & API → SMTP → generate an SMTP key
#   SMTP_HOST: smtp-relay.brevo.com
#   SMTP_USER: the SMTP login email shown by Brevo
#   SMTP_PASS: the SMTP key you generated
#
# Legacy option — Gmail SMTP (may be blocked from cloud servers):
#   Google Account → Security → 2-Step Verification → App Passwords
#   EMAIL_USER=yourgmail@gmail.com
#   EMAIL_PASS=your-16-character-app-password

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login@example.com
SMTP_PASS=your-brevo-smtp-key
ADMIN_EMAIL=admin@vertexsolutions.in

# Optional — "From" address (defaults to SMTP_USER)
# MAIL_FROM=no-reply@yourdomain.com

# Optional — port the server listens on (defaults to 5000)
# PORT=5000